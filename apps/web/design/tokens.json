  "size-frame": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Height of in-page overlay sample frames"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
  "border-width-strong": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}},
